{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxrecord.dev/schema/wire-format-v1.json",
  "title": "fluxrecord wire format, version 1",
  "description": "The shapes fluxrecord reads and writes. A third-party implementation that produces and consumes these shapes interoperates with fluxrecord. Adding a field is a minor version; removing one, renaming one, or changing its type is a major version.",
  "$defs": {
    "status": {
      "description": "The station a ticket is in.",
      "enum": ["ready", "in_progress", "blocked", "review", "done", "cancelled"]
    },
    "priority": {
      "description": "1 is now, 2 is next, 3 is later.",
      "enum": [1, 2, 3]
    },
    "kind": {
      "description": "The kind of work a ticket is.",
      "enum": ["code", "fix", "closure", "planning", "product"]
    },
    "taskId": {
      "description": "A ticket identifier.",
      "type": "string",
      "minLength": 1
    },
    "task": {
      "description": "One ticket, as the ledger holds it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "acceptance",
        "kind",
        "scope",
        "status",
        "token_budget",
        "created"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "objective": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "scope": {
          "description": "Resource keys. Two tickets with overlapping scope cannot be in progress at once.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "$ref": "#/$defs/status" },
        "token_budget": { "type": "integer", "minimum": 1 },
        "created": { "type": "number" },
        "updated_at": { "type": ["number", "null"] },
        "title": { "type": "string" },
        "priority": { "$ref": "#/$defs/priority" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/taskId" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/taskId" } },
        "owner": { "type": "string" },
        "seed_key": { "type": "string" }
      }
    },
    "session": {
      "description": "One worker's claim on a ticket.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_id", "owner", "status", "lease_until", "tokens", "created"],
      "properties": {
        "id": { "type": "string" },
        "task_id": { "$ref": "#/$defs/taskId" },
        "owner": { "type": "string" },
        "status": {
          "enum": ["active", "finished", "failed", "expired", "blocked"]
        },
        "lease_until": { "type": "number" },
        "tokens": { "type": "integer", "minimum": 0 },
        "progress": { "type": "string" },
        "stagnant": { "type": "integer", "minimum": 0 },
        "created": { "type": "number" },
        "lease_remaining": { "type": "number" },
        "expired": { "type": "boolean" }
      }
    },
    "failure": {
      "description": "A recorded failure, grouped by a stable fingerprint.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "category", "summary"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["lease_expired", "budget", "tool", "dependency", "no_progress"]
        },
        "summary": { "type": "string" },
        "created": { "type": "number" },
        "occurrences": { "type": "integer", "minimum": 0 }
      }
    },
    "profile": {
      "description": "A declared way of working: what it is for, what it costs, and what it needs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kinds", "context_limit", "cost"],
      "properties": {
        "id": { "type": "string" },
        "kinds": { "type": "array", "items": { "$ref": "#/$defs/kind" } },
        "context_limit": { "type": "integer", "minimum": 1 },
        "cost": { "enum": ["zero_incremental", "paid", "unknown"] },
        "verified_until": { "type": "number" },
        "requires": { "type": "array", "items": { "type": "string" } }
      }
    },
    "event": {
      "description": "One entry in the event log.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "type", "data", "created"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "minLength": 1 },
        "task_id": { "type": ["string", "null"] },
        "data": { "type": "object" },
        "created": { "type": "number" },
        "digest": { "type": "string" }
      }
    },
    "statusReport": {
      "description": "The output of `flux status`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "sessions", "failures", "metrics"],
      "properties": {
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/failure" } },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/profile" } },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "reported_tokens"],
          "properties": {
            "accepted": { "type": "integer", "minimum": 0 },
            "reported_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ticketList": {
      "description": "The output of `flux list`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tickets", "count", "filters"],
      "properties": {
        "tickets": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "count": { "type": "integer", "minimum": 0 },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "type": ["string", "null"] },
            "priority": { "type": ["integer", "null"] },
            "kind": { "type": ["string", "null"] },
            "owner": { "type": ["string", "null"] },
            "tag": { "type": ["string", "null"] },
            "scope": { "type": ["string", "null"] }
          }
        }
      }
    },
    "packet": {
      "description": "The output of `flux pack`: a bounded context packet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["packet", "packet_bytes", "omitted"],
      "properties": {
        "packet": {
          "type": "object",
          "required": ["task_id", "objective", "acceptance", "status", "context"],
          "properties": {
            "task_id": { "$ref": "#/$defs/taskId" },
            "title": { "type": "string" },
            "objective": { "type": "string" },
            "acceptance": { "type": "string" },
            "kind": { "$ref": "#/$defs/kind" },
            "scope": { "type": "array", "items": { "type": "string" } },
            "status": { "$ref": "#/$defs/status" },
            "priority": { "$ref": "#/$defs/priority" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "depends_on": { "type": "array", "items": { "$ref": "#/$defs/taskId" } },
            "owner": { "type": "string" },
            "token_budget": { "type": "integer", "minimum": 1 },
            "checkpoint": { "type": ["object", "null"] },
            "failures": { "type": "array", "items": { "$ref": "#/$defs/failure" } },
            "trust": { "type": "string" },
            "context": { "type": "array" }
          }
        },
        "packet_bytes": { "type": "integer", "minimum": 0 },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hash": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "note": { "type": "string" }
      }
    },
    "ticketFile": {
      "description": "The front matter of an exported ticket file. The file is the contract a human reviews, and this is the machine-readable half of it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "kind", "scope", "token_budget"],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "title": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "$ref": "#/$defs/priority" },
        "kind": { "$ref": "#/$defs/kind" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "token_budget": { "type": "integer", "minimum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/taskId" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/taskId" } },
        "owner": { "type": "string" },
        "seed_key": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    }
  }
}
