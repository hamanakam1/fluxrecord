{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxrecord.dev/schema/wire-format-v1.json",
  "title": "fluxrecord wire format, version 1",
  "description": "The shapes fluxrecord reads and writes. A third-party implementation that produces and consumes these shapes interoperates with fluxrecord. Adding a field is a minor version; removing one, renaming one, or changing its type is a major version.",
  "x-wire-format": 1,
  "$defs": {
    "ticket": {
      "type": "object",
      "required": [
        "acceptance",
        "blocks",
        "created",
        "depends_on",
        "id",
        "kind",
        "objective",
        "owner",
        "priority",
        "scope",
        "seed_key",
        "status",
        "tags",
        "title",
        "token_budget",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "acceptance": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "code",
            "fix",
            "closure",
            "planning",
            "product"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
