      "properties": {
        "id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "lease_until": {
          "type": "number"
        },
        "tokens": {
          "type": "integer"
        },
        "created": {
          "type": "number"
