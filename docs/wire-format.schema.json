          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "seed_key": {
          "type": "string"
        },
        "updated_at": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "ticket_file": {
      "type": "object",
